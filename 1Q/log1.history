 1  clear
    2  mkdir Work_Course_Linux && cd Work_Course_Linux
    3  git init
    4  echo "Name: Tomer Levi" > .myid
    5  echo "ID: 210027413" > .myid
    6  echo "Name: Tomer Levi" >> .myid
    7  git add .
    8  git commit -m "START"
    9  mkdir DOWNLOADS
   10  wget https://github.com/TelHai-Git/LINUX_COURSE_WORK/archive/refs/tags/downloads.tar.gz -O downloads.tar.gz
   11  tar -xzf downloads.tar.gz -C DOWNLOADS
   12  rm downloads.tar.gz
   13  git add .
   14  git commit -m "Add downloaded files"
   15  mkdir DATA CODE
   16  cp DOWNLOADS/*.{c,cpp,py,sh,java} CODE/ 2>/dev/null
   17  cp DOWNLOADS/*.{py} CODE/ 
   18  cp DOWNLOADS/*.py CODE/ 2>/dev/null
   19  find DOWNLOADS -type f -name '*.py' -exec cp {} CODE/ \;
   20  cp DOWNLOADS/*.{txt,jpg,csv} DATA/ 2>/dev/null
   21  find DOWNLOADS -type f \( -iname '*.txt' -o -iname '*.jpg' -o -iname '*.csv' \) -exec cp {} DATA/ \;
   22  git checkout -b 1_question
   23  git checkout -b question_1
   24  mkdir 1Q
   25  echo "Time : $(date)" > 1Q/txt.output_1q
   26  echo "USER DETAILS: $(grep "^$USER" /etc/passwd)" >> 1Q/txt.output_1q
   27  echo "REPO: $(pwd)" >> 1Q/txt.output_1q
   28  echo "BRANCH: $(git branch --show-current)" >> 1Q/txt.output_1q
   29  echo -n "VERSIONID: " >> 1Q/txt.output_1q
   30  grep "^VERSION_ID=" /etc/os-release | cut -d= -f2 | tr -d '"' >> 1Q/txt.output_1q
   31  echo "-------------------------------------------" >> 1Q/txt.output_1q
   32  ls -R >> 1Q/txt.output_1q
   33  git log > 1Q/log1.history
   34  git add .
   35  git commit -m "Add Q1 files"
   36  git checkout main
   37  git merge question_1
   38  git branch -m 1_question question_1
